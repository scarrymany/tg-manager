<Window x:Class="TGManager.Windows.FolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Папка контейнеров" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        ResizeMode="NoResize" Background="Transparent" FontSize="13">
    <Border x:Name="WindowFrame" CornerRadius="12" Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource HairlineStrongBrush}" BorderThickness="1" Padding="24">
        <StackPanel>
            <TextBlock x:Name="Heading" Text="Новая папка" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource FgWhiteBrush}"/>
            <TextBlock Text="Объедините контейнеры по проекту или назначению." TextWrapping="Wrap" Margin="0,8,0,20" Foreground="{StaticResource MutedBrush}"/>
            <TextBlock Text="Название папки" Margin="0,0,0,8"/>
            <TextBox x:Name="NameBox" Style="{StaticResource FieldBox}" MaxLength="64"/>
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource YellowBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Отмена" Style="{StaticResource GhostButton}" IsCancel="True" Margin="0,0,8,0"/>
                <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnSave"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
