<Window x:Class="TGManager.Windows.FolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Папка контейнеров" Width="440" SizeToContent="Height" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        ResizeMode="NoResize" Background="Transparent" FontSize="13"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource FgBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="48" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="6" UseAeroCaptionButtons="False" NonClientFrameEdges="None"/></WindowChrome.WindowChrome>
    <Border x:Name="WindowFrame" CornerRadius="6" Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1"><TextBlock x:Name="Heading" Text="Новая папка" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource FgWhiteBrush}" VerticalAlignment="Center" Margin="20,0"/></Border>
            <StackPanel Grid.Row="1" Margin="20,16">
                <TextBlock Text="Объедините контейнеры по проекту или назначению." TextWrapping="Wrap" Margin="0,0,0,20" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="Название папки" Margin="0,0,0,8" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                <TextBox x:Name="NameBox" Style="{StaticResource FieldBox}" MaxLength="64"/>
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource YellowBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
            <Border Grid.Row="2" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,16">
                <Button Content="Отмена" Style="{StaticResource GhostButton}" IsCancel="True" Margin="0,0,8,0"/>
                <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnSave"/>
            </StackPanel></Border>
        </Grid>
    </Border>
</Window>
