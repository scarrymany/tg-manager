<Window x:Class="TGManager.Windows.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Контейнер"
        Width="460" Height="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="16" UseAeroCaptionButtons="False" NonClientFrameEdges="None"/>
    </WindowChrome.WindowChrome>
    <Border x:Name="WindowFrame" Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="16,0,8,0">
                <TextBlock x:Name="TitleText" Text="Новый контейнер" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource FgWhiteBrush}" VerticalAlignment="Center"/>
                <Button Style="{StaticResource CloseButton}" HorizontalAlignment="Right" Click="OnClose">
                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2" Data="M5,5 L15,15 M15,5 L5,15" Width="20" Height="20"/>
                </Button>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22,8,22,8">
                    <TextBlock Text="НАЗВАНИЕ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubtleBrush}" Margin="0,0,0,6"/>
                    <TextBox x:Name="NameBox" Style="{StaticResource FieldBox}" Margin="0,0,0,14"/>

                    <TextBlock Text="ЦВЕТ КАРТОЧКИ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubtleBrush}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="ColorBox" Style="{StaticResource FieldCombo}" Margin="0,0,0,14" SelectionChanged="OnColorChanged"/>

                    <TextBlock Text="ПРОКСИ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubtleBrush}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="ProxyBox" Style="{StaticResource FieldCombo}" Margin="0,0,0,14" SelectionChanged="OnProxyChanged">
                        <ComboBoxItem Content="Без прокси" Tag="none"/>
                        <ComboBoxItem Content="HTTP" Tag="http"/>
                        <ComboBoxItem Content="SOCKS5" Tag="socks5"/>
                    </ComboBox>

                    <TextBlock Text="СТРОКОЙ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubtleBrush}" Margin="0,0,0,6"/>
                    <TextBox x:Name="LineBox" Style="{StaticResource FieldBox}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="LineHint" FontSize="12" Foreground="{StaticResource SubtleBrush}" Margin="0,0,0,14"/>

                    <TextBlock Text="АДРЕС : ПОРТ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubtleBrush}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,14" x:Name="HpRow">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="96"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HostBox" Style="{StaticResource FieldBox}" Margin="0,0,8,0"/>
                        <TextBox x:Name="PortBox" Grid.Column="1" Style="{StaticResource FieldBox}" Text="1080"/>
                    </Grid>

                    <TextBlock Text="АВТОРИЗАЦИЯ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubtleBrush}" Margin="0,0,0,6"/>
                    <Grid x:Name="UpRow" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="UserBox" Style="{StaticResource FieldBox}" Margin="0,0,8,0"/>
                        <PasswordBox x:Name="PassBox" Grid.Column="1"/>
                    </Grid>

                    <TextBlock Text="После создания нажмите «Папка» в строке контейнера и положите туда папку tdata от нужного аккаунта."
                               TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource SubtleBrush}"/>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="22,8,22,18">
                <Button Style="{StaticResource GhostButton}" Content="Отмена" Click="OnClose" Margin="0,0,8,0"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Сохранить" Click="OnSave"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
