<Window x:Class="TGManager.Windows.DownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Скачивание"
        Width="520" Height="360"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="16" UseAeroCaptionButtons="False" NonClientFrameEdges="None"/>
    </WindowChrome.WindowChrome>
    <Border x:Name="WindowFrame" Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Text="Скачивание" Margin="18,0" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource FgWhiteBrush}" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="1" Margin="22,8,22,8">
                <TextBlock x:Name="HintText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource SubtleBrush}" Margin="0,0,0,12"/>
                <ProgressBar x:Name="Bar" Height="6" IsIndeterminate="True" Minimum="0" Maximum="1" Margin="0,0,0,12"/>
                <TextBox x:Name="LogBox" Style="{StaticResource FieldBox}" Height="140" IsReadOnly="True"
                         FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalScrollBarVisibility="Auto"
                         AcceptsReturn="True" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="22,8,22,16">
                <Button x:Name="CloseBtn" Style="{StaticResource GhostButton}" Content="Отмена" Click="OnClose"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
