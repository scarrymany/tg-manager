<Window x:Class="TGManager.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:TGManager.Services" xmlns:vm="clr-namespace:TGManager.ViewModels"
        Title="TG Manager" Width="1260" Height="820" MinWidth="1040" MinHeight="560"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        ResizeMode="CanResize" Background="Transparent" Closing="OnClosing"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource FgBrush}"
        FontSize="13"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="6" UseAeroCaptionButtons="False" NonClientFrameEdges="None"/></WindowChrome.WindowChrome>
    <Window.Resources>
        <svc:BoolToVis x:Key="BoolToVis"/><svc:InvBoolToVis x:Key="InvBoolToVis"/>
        <!-- Кнопки карточки: размеры, отступы и состав берутся из ListLayout (настройки списка), поэтому меняются без перезапуска. -->
        <Style x:Key="CardPrimary" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Height" Value="{Binding Layout.ButtonHeight}"/><Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="{Binding Layout.ButtonMinWidth}"/>
            <Setter Property="Padding" Value="{Binding Layout.ButtonPadding}"/><Setter Property="Margin" Value="{Binding Layout.ButtonMargin}"/><Setter Property="FontSize" Value="{Binding Layout.ButtonFontSize}"/>
        </Style>
        <Style x:Key="CardGhost" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Height" Value="{Binding Layout.ButtonHeight}"/><Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="{Binding Layout.ButtonMinWidth}"/>
            <Setter Property="Padding" Value="{Binding Layout.ButtonPadding}"/><Setter Property="Margin" Value="{Binding Layout.ButtonMargin}"/><Setter Property="FontSize" Value="{Binding Layout.ButtonFontSize}"/>
        </Style>
        <Style x:Key="CardDanger" TargetType="Button" BasedOn="{StaticResource DangerButton}">
            <Setter Property="Height" Value="{Binding Layout.ButtonHeight}"/><Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="{Binding Layout.ButtonMinWidth}"/>
            <Setter Property="Padding" Value="{Binding Layout.ButtonPadding}"/><Setter Property="Margin" Value="{Binding Layout.ButtonMargin}"/><Setter Property="FontSize" Value="{Binding Layout.ButtonFontSize}"/>
        </Style>
        <Style x:Key="ActionIcon" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><Setter Property="StrokeThickness" Value="1.2"/>
            <Setter Property="Stretch" Value="Uniform"/><Setter Property="Width" Value="{Binding Layout.IconSize}"/><Setter Property="Height" Value="{Binding Layout.IconSize}"/>
            <Setter Property="Visibility" Value="{Binding Layout.IconsOnly, Converter={StaticResource BoolToVis}}"/>
        </Style>
        <Style x:Key="ActionIconSolid" TargetType="Path" BasedOn="{StaticResource ActionIcon}">
            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Style>
        <Style x:Key="ActionLabel" TargetType="TextBlock">
            <Setter Property="Visibility" Value="{Binding Layout.ShowLabels, Converter={StaticResource BoolToVis}}"/>
        </Style>
    </Window.Resources>
    <Border x:Name="WindowFrame" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="2" Background="{StaticResource BgSideBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="14,0,4,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="/Assets/logo_mark.png" Width="16" Height="16"/><TextBlock Text="TG Manager" Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource ChromeButton}" Click="OnMinimize" ToolTip="Свернуть" AutomationProperties.Name="Свернуть"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Data="M5,10 H15" Width="20" Height="20"/></Button>
                        <Button x:Name="MaxButton" Style="{StaticResource ChromeButton}" Click="OnMaximize" ToolTip="Развернуть" AutomationProperties.Name="Развернуть"><Path x:Name="MaxIcon" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Data="M5,5 H15 V15 H5 Z" Width="20" Height="20"/></Button>
                        <Button Style="{StaticResource CloseButton}" Click="OnCloseClick" ToolTip="Закрыть" AutomationProperties.Name="Закрыть"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Data="M5,5 L15,15 M15,5 L5,15" Width="20" Height="20"/></Button>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="1" Background="{StaticResource BgSideBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="20,24,20,26" Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource AccentBrush}"><Path Fill="#0A0A0A" Data="M1,6 L25,1 L18,24 L12,17 L7,21 L8,13 Z M8,13 L20,5 L12,17" Width="24" Height="24" Stretch="Uniform"/></Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="TG MANAGER" FontSize="14" FontWeight="Bold" Foreground="{StaticResource FgWhiteBrush}"/><TextBlock Text="SCARP.CC" FontSize="10" Margin="0,3,0,0" Foreground="{StaticResource SubtleBrush}"/></StackPanel>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="12,0,12,16">
                            <TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО" Style="{StaticResource SectionLabel}" Margin="14,0,0,10" FontSize="10"/>
                            <Button x:Name="NavContainers" Style="{StaticResource NavButton}" Tag="active" Click="OnNavContainers"><StackPanel Orientation="Horizontal"><Path Data="M1,1 H7 V7 H1 Z M11,1 H17 V7 H11 Z M1,11 H7 V17 H1 Z M11,11 H17 V17 H11 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="18" Height="18" Margin="0,0,11,0"/><TextBlock Text="Контейнеры" VerticalAlignment="Center"/></StackPanel></Button>
                            <Button x:Name="NavTasks" Style="{StaticResource NavButton}" Click="OnNavTasks"><StackPanel Orientation="Horizontal"><Path Data="M3,1 H15 V17 H3 Z M6,5 H12 M6,9 H12 M6,13 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="18" Height="18" Margin="0,0,11,0"/><TextBlock x:Name="NavTasksLabel" Text="Активные задачи" VerticalAlignment="Center"/></StackPanel></Button>
                            <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="14,20,14,20"/>
                            <TextBlock Text="ПАПКИ КОНТЕЙНЕРОВ" Style="{StaticResource SectionLabel}" Margin="14,0,0,10" FontSize="10"/>
                            <ComboBox x:Name="FolderFilter" Style="{StaticResource FieldCombo}" SelectionChanged="OnFilterChanged" AutomationProperties.Name="Папка контейнеров" Margin="2,0,2,10"/>
                            <Grid Margin="2,0,2,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                <Button Content="+ Папка" Style="{StaticResource GhostButton}" Click="OnCreateFolder" Padding="8,8" Margin="0,0,6,0"/>
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Click="OnRenameFolder" IsEnabled="{Binding CanManageFolder}" Padding="0" Margin="0,0,6,0" ToolTip="Переименовать папку" AutomationProperties.Name="Переименовать папку"><Path Data="M3,12 L11,4 L14,7 L6,15 H3 Z M10,5 L13,8" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.2" Width="18" Height="18"/></Button>
                                <Button Grid.Column="2" Style="{StaticResource DangerButton}" Click="OnDeleteFolder" IsEnabled="{Binding CanManageFolder}" Padding="0" ToolTip="Удалить папку, сохранив контейнеры" AutomationProperties.Name="Удалить папку"><Path Data="M4,4 H14 M7,1 H11 M5,4 L6,16 H12 L13,4 M8,7 V13 M10,7 V13" Stroke="{StaticResource RedBrush}" StrokeThickness="1.1" Width="18" Height="18"/></Button>
                            </Grid>
                            <TextBlock Text="Группировка по проектам.&#x0a;Данные остаются в контейнерах." Foreground="{StaticResource SubtleBrush}" FontSize="11" TextWrapping="Wrap" Margin="14,14,10,0" LineHeight="17"/>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Margin="12,0,12,16">
                        <Button Style="{StaticResource NavButton}" Click="OnOpenSettings"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" Width="18" Margin="0,0,11,0" FontSize="17"/><TextBlock Text="Настройки" VerticalAlignment="Center"/></StackPanel></Button>
                        <StackPanel Orientation="Horizontal" Margin="14,10,0,0"><Button Style="{StaticResource ChromeButton}" Content="GitHub" Width="65" Height="26" Click="OnGitHub" FontSize="11"/><Button Style="{StaticResource ChromeButton}" Content="Telegram" Width="70" Height="26" Click="OnTelegram" FontSize="11" ToolTip="Разработчик @yeet17"/></StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Grid.Column="1">
                <Grid x:Name="ContainersPage">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="{Binding Layout.HeaderMargin}">
                        <Grid Margin="{Binding Layout.SectionGap}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Контейнеры" FontSize="21" FontWeight="Bold" Foreground="{StaticResource FgWhiteBrush}"/><TextBlock Text="Ваши Telegram-аккаунты в одном рабочем пространстве" Foreground="{StaticResource MutedBrush}" Margin="0,7,12,0" TextWrapping="Wrap" Visibility="{Binding Layout.ShowSubtitle, Converter={StaticResource BoolToVis}}"/></StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="+  Добавить контейнер" Click="OnAddAccount" VerticalAlignment="Top"/>
                        </Grid>
                        <UniformGrid Columns="4" Margin="0,0,-12,0">
                            <Border Style="{StaticResource StatPanel}" Padding="{Binding Layout.StatPadding}" Margin="0,0,12,0"><StackPanel><TextBlock Text="{Binding TotalCount}" FontSize="{Binding Layout.StatValueSize}" FontWeight="Bold" Foreground="{StaticResource FgWhiteBrush}"/><TextBlock Text="Всего контейнеров" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="{Binding Layout.StatLabelMargin}"/></StackPanel></Border>
                            <Border Style="{StaticResource StatPanel}" Padding="{Binding Layout.StatPadding}" Margin="0,0,12,0"><StackPanel><TextBlock Text="{Binding RunningCount}" FontSize="{Binding Layout.StatValueSize}" FontWeight="Bold" Foreground="{StaticResource FgWhiteBrush}"/><TextBlock Text="Запущено" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="{Binding Layout.StatLabelMargin}"/></StackPanel></Border>
                            <Border Style="{StaticResource StatPanel}" Padding="{Binding Layout.StatPadding}" Margin="0,0,12,0"><StackPanel><TextBlock Text="{Binding BusyCount}" FontSize="{Binding Layout.StatValueSize}" FontWeight="Bold" Foreground="{StaticResource FgWhiteBrush}"/><TextBlock Text="Занято задачами" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="{Binding Layout.StatLabelMargin}"/></StackPanel></Border>
                            <Border Style="{StaticResource StatPanel}" Padding="{Binding Layout.StatPadding}" Margin="0,0,12,0"><StackPanel><TextBlock Text="{Binding MissingDataCount}" FontSize="{Binding Layout.StatValueSize}" FontWeight="Bold" Foreground="{StaticResource FgWhiteBrush}"/><TextBlock Text="Без tdata" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="{Binding Layout.StatLabelMargin}"/></StackPanel></Border>
                        </UniformGrid>
                        <Grid Margin="{Binding Layout.FilterMargin}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="176"/><ColumnDefinition Width="176"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0"><TextBlock Text="Поиск" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,7"/><TextBox x:Name="SearchBox" Style="{StaticResource FieldBox}" TextChanged="OnSearchChanged" ToolTip="Имя, ID, заметка или прокси. Ctrl+F / Escape" AutomationProperties.Name="Поиск контейнеров"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Состояние" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,7"/><ComboBox x:Name="FilterBox" Style="{StaticResource FieldCombo}" SelectedIndex="0" SelectionChanged="OnFilterChanged" AutomationProperties.Name="Фильтр состояния"><ComboBoxItem Content="Все контейнеры"/><ComboBoxItem Content="Запущены"/><ComboBoxItem Content="Остановлены"/><ComboBoxItem Content="Заняты"/><ComboBoxItem Content="Без tdata"/></ComboBox></StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="Порядок" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,7"/><ComboBox x:Name="SortBox" Style="{StaticResource FieldCombo}" SelectedIndex="0" SelectionChanged="OnSortChanged" AutomationProperties.Name="Сортировка контейнеров"><ComboBoxItem Content="Как добавлены"/><ComboBoxItem Content="Имя: А → Я"/><ComboBoxItem Content="Имя: Я → А"/></ComboBox></StackPanel>
                            <Button Grid.Column="3" Content="Сбросить" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom" Height="42" Click="OnResetFilters"/>
                        </Grid>
                        <TextBlock Text="{Binding ResultCount}" Foreground="{StaticResource SubtleBrush}" FontSize="11" Margin="{Binding Layout.ResultMargin}"/>
                    </StackPanel>
                    <ItemsControl Grid.Row="1" x:Name="AccountList" Visibility="{Binding HasAccounts, Converter={StaticResource BoolToVis}}"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                        <ItemsControl.Template><ControlTemplate TargetType="ItemsControl"><ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True"><ItemsPresenter/></ScrollViewer></ControlTemplate></ItemsControl.Template>
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel Margin="26,0,18,16"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:AccountVm}">
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True" Margin="{Binding Layout.CardGap}" Padding="{Binding Layout.CardPadding}">
                                <Border.ContextMenu><ContextMenu><MenuItem Header="Запуск" Tag="{Binding Id}" Click="OnLaunch" IsEnabled="{Binding CanLaunch}"/><MenuItem Header="Стоп" Tag="{Binding Id}" Click="OnStop" IsEnabled="{Binding CanStop}"/><Separator/><MenuItem Header="Экспорт session" Tag="{Binding Id}" Click="OnExportSession" IsEnabled="{Binding CanExport}"/><MenuItem Header="Папка контейнера" Tag="{Binding Id}" Click="OnFolder"/><MenuItem Header="Автоматизация (чистка)" Tag="{Binding Id}" Click="OnCleanup" IsEnabled="{Binding CanCleanup}"/><Separator/><MenuItem Header="Изменить" Tag="{Binding Id}" Click="OnEdit" IsEnabled="{Binding CanEdit}"/><MenuItem Header="Удалить" Tag="{Binding Id}" Click="OnDelete" IsEnabled="{Binding CanEdit}"/></ContextMenu></Border.ContextMenu>
                                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Background="{Binding ColorBrush}" Width="3" Height="{Binding Layout.AccentBarHeight}" CornerRadius="2" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="{Binding Layout.InfoMargin}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="{Binding Layout.NameSize}" FontWeight="SemiBold" Foreground="{StaticResource FgWhiteBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                        <TextBlock Margin="{Binding Layout.MetaMargin}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding MetaFull}"><Run Text="{Binding MetaLeft, Mode=OneWay}"/><Run Text="{Binding TdataLabel, Mode=OneWay}" Foreground="{Binding TdataBrush}"/><Run Text="{Binding NotesSuffix, Mode=OneWay}"/></TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" MaxWidth="150" VerticalAlignment="Center"><Border Background="{Binding StatusBg}" CornerRadius="4" Padding="{Binding Layout.StatusPadding}" HorizontalAlignment="Right"><TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{Binding StatusFg}"/></Border><TextBlock Text="{Binding FolderLabel}" FontSize="11" Foreground="{StaticResource SubtleBrush}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip="{Binding FolderLabel}" Margin="{Binding Layout.FolderMargin}"/></StackPanel>
                                    <WrapPanel x:Name="Actions" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Center" Margin="{Binding Layout.ActionsMargin}" Visibility="{Binding Layout.HasActions, Converter={StaticResource BoolToVis}}">
                                        <Button Style="{StaticResource CardPrimary}" IsEnabled="{Binding CanLaunch}" Tag="{Binding Id}" Click="OnLaunch" ToolTip="Запуск" AutomationProperties.Name="Запуск" Visibility="{Binding Layout.ShowLaunch, Converter={StaticResource BoolToVis}}"><Grid><Path Style="{StaticResource ActionIconSolid}" Data="M5,3 L15,9 L5,15 Z"/><TextBlock Style="{StaticResource ActionLabel}" Text="▶  Запуск"/></Grid></Button>
                                        <Button Style="{StaticResource CardDanger}" IsEnabled="{Binding CanStop}" Tag="{Binding Id}" Click="OnStop" ToolTip="Стоп" AutomationProperties.Name="Стоп" Visibility="{Binding Layout.ShowStop, Converter={StaticResource BoolToVis}}"><Grid><Path Style="{StaticResource ActionIconSolid}" Data="M4,4 H14 V14 H4 Z"/><TextBlock Style="{StaticResource ActionLabel}" Text="■  Стоп"/></Grid></Button>
                                        <Button Style="{StaticResource CardGhost}" Tag="{Binding Id}" Click="OnFolder" ToolTip="Папка контейнера" AutomationProperties.Name="Папка" Visibility="{Binding Layout.ShowFolder, Converter={StaticResource BoolToVis}}"><Grid><Path Style="{StaticResource ActionIcon}" Data="M2,4 H7 L9,6 H16 V15 H2 Z"/><TextBlock Style="{StaticResource ActionLabel}" Text="Папка"/></Grid></Button>
                                        <Button Style="{StaticResource CardGhost}" IsEnabled="{Binding CanExport}" Tag="{Binding Id}" Click="OnExportSession" ToolTip="Экспорт session" AutomationProperties.Name="Экспорт session" Visibility="{Binding Layout.ShowExport, Converter={StaticResource BoolToVis}}"><Grid><Path Style="{StaticResource ActionIcon}" Data="M9,12 V2 M5,6 L9,2 L13,6 M3,10 V16 H15 V10"/><TextBlock Style="{StaticResource ActionLabel}" Text="{Binding Layout.ExportLabel}"/></Grid></Button>
                                        <Button Style="{StaticResource CardGhost}" IsEnabled="{Binding CanCleanup}" Tag="{Binding Id}" Click="OnCleanup" ToolTip="Чистка аккаунта" AutomationProperties.Name="Чистка" Visibility="{Binding Layout.ShowCleanup, Converter={StaticResource BoolToVis}}"><Grid><Path Style="{StaticResource ActionIcon}" Data="M3,5 H15 M3,9 H11 M3,13 H7"/><TextBlock Style="{StaticResource ActionLabel}" Text="Чистка"/></Grid></Button>
                                        <Button Style="{StaticResource CardGhost}" IsEnabled="{Binding CanEdit}" Tag="{Binding Id}" Click="OnEdit" ToolTip="Изменить контейнер" AutomationProperties.Name="Изменить" Visibility="{Binding Layout.ShowEdit, Converter={StaticResource BoolToVis}}"><Grid><Path Style="{StaticResource ActionIcon}" Data="M3,12 L11,4 L14,7 L6,15 H3 Z M10,5 L13,8"/><TextBlock Style="{StaticResource ActionLabel}" Text="Изменить"/></Grid></Button>
                                        <Button Style="{StaticResource CardDanger}" IsEnabled="{Binding CanEdit}" Tag="{Binding Id}" Click="OnDelete" ToolTip="Удалить контейнер" AutomationProperties.Name="Удалить" Visibility="{Binding Layout.ShowDelete, Converter={StaticResource BoolToVis}}"><Grid><Path Style="{StaticResource ActionIcon}" Data="M4,4 H14 M7,1 H11 M5,4 L6,16 H12 L13,4 M8,7 V13 M10,7 V13"/><TextBlock Style="{StaticResource ActionLabel}" Text="Удалить"/></Grid></Button>
                                    </WrapPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Layout.Inline}" Value="True">
                                    <Setter TargetName="Actions" Property="Grid.Row" Value="0"/><Setter TargetName="Actions" Property="Grid.Column" Value="3"/><Setter TargetName="Actions" Property="Grid.ColumnSpan" Value="1"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="26" Visibility="{Binding NoResults, Converter={StaticResource BoolToVis}}"><TextBlock Text="Ничего не найдено" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Измените запрос, папку или состояние." Foreground="{StaticResource MutedBrush}" Margin="0,10,0,18"/><Button Content="Сбросить фильтры" Style="{StaticResource GhostButton}" Click="OnResetFilters" HorizontalAlignment="Center"/></StackPanel>
                    <StackPanel Grid.Row="1" x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="26" Visibility="{Binding HasAccounts, Converter={StaticResource InvBoolToVis}}"><Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="6" Width="56" Height="56" HorizontalAlignment="Center"><Image Source="/Assets/logo_mark.png" Width="26" Height="26"/></Border><TextBlock Text="Пока нет контейнеров" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource FgWhiteBrush}" HorizontalAlignment="Center" Margin="0,16,0,0"/><TextBlock Text="Создайте контейнер и добавьте tdata в его папку." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,20"/><Button Content="+  Создать контейнер" Style="{StaticResource PrimaryButton}" Click="OnAddAccount" HorizontalAlignment="Center"/></StackPanel>
                </Grid>
                <Grid x:Name="TasksPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="26,22,26,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Активные задачи" FontSize="21" FontWeight="Bold" Foreground="{StaticResource FgWhiteBrush}"/><TextBlock Text="Чистка и экспорт: состояние, прогресс и журнал" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,12,0"/></StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button Style="{StaticResource GhostButton}" Content="Очистить завершённые" Click="OnClearFinished" Margin="0,0,8,0"/><Button Style="{StaticResource DangerButton}" Content="Остановить все" Click="OnStopAll"/></StackPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasTasks, Converter={StaticResource BoolToVis}}"><ItemsControl x:Name="TaskList" Margin="26,0,26,22"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:TaskVm}">
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="6" Padding="18,16" Margin="0,0,0,12"><Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource FgWhiteBrush}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SubLabel}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/></StackPanel>
                                <Border Grid.Column="1" Background="{StaticResource HoverBrush}" CornerRadius="4" Padding="8,4" VerticalAlignment="Top"><TextBlock Text="{Binding PillText}" FontSize="11" Foreground="{Binding PillFg}"/></Border>
                                <Grid Grid.Row="1" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ProgressBar Minimum="0" Maximum="{Binding ProgressMax, Mode=OneWay}" Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,14,0"/><TextBlock Grid.Column="1" Text="{Binding CountText}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/></Grid>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,16,0,0"><Button Content="Журнал" Style="{StaticResource GhostButton}" Tag="{Binding Id}" Click="OnTaskLog" MinHeight="36" Padding="12,6" Margin="0,0,8,0"/><Button Content="{Binding ActionButtonText}" Style="{StaticResource StopButton}" Tag="{Binding Id}" Click="OnTaskAction" MinHeight="36" Padding="12,6"/></StackPanel>
                            </Grid></Border>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="26" Visibility="{Binding HasTasks, Converter={StaticResource InvBoolToVis}}"><TextBlock Text="Нет активных задач" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Запустите чистку или экспорт session из контейнера.&#x0a;Здесь появятся прогресс и журнал выполнения." Foreground="{StaticResource MutedBrush}" TextAlignment="Center" Margin="0,10,0,0" LineHeight="21"/></StackPanel>
                    </Grid>
                </Grid>
            </Grid>
            <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource BgSideBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0"><Grid Margin="14,0"><TextBlock x:Name="StatusText" Text="TG Manager" Foreground="{StaticResource SubtleBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,100,0"/><TextBlock x:Name="VersionText" Foreground="{StaticResource SubtleBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
        </Grid>
    </Border>
</Window>
