<Window x:Class="TGManager.Windows.TaskLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Журнал"
        Width="580" Height="440"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        MinWidth="480" MinHeight="320"
        Background="Transparent"
        ShowInTaskbar="False">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="16" UseAeroCaptionButtons="False" NonClientFrameEdges="None"/>
    </WindowChrome.WindowChrome>
    <Border x:Name="WindowFrame" Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="16,0,8,0">
                <TextBlock x:Name="TitleText" Text="Журнал" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource FgWhiteBrush}" VerticalAlignment="Center"/>
                <Button Style="{StaticResource CloseButton}" HorizontalAlignment="Right" Click="OnClose">
                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2" Data="M5,5 L15,15 M15,5 L5,15" Width="20" Height="20"/>
                </Button>
            </Grid>
            <TextBox x:Name="LogBox" Grid.Row="1" Style="{StaticResource FieldBox}" Margin="18,8,18,8"
                     IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12"
                     VerticalScrollBarVisibility="Auto" AcceptsReturn="True" TextWrapping="Wrap"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,0,18,16">
                <Button Style="{StaticResource GhostButton}" Content="Закрыть" Click="OnClose"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
