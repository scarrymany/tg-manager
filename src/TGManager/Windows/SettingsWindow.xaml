<Window x:Class="TGManager.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки"
        Width="580" Height="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        MinWidth="520" MinHeight="480"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource FgBrush}"
        FontSize="13"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="6" UseAeroCaptionButtons="False" NonClientFrameEdges="None"/>
    </WindowChrome.WindowChrome>
    <Border x:Name="WindowFrame" Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" IsHitTestVisible="False"/>
            <Border Grid.Row="2" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" IsHitTestVisible="False"/>
            <Grid Margin="20,0,8,0">
                <TextBlock Text="Настройки" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource FgWhiteBrush}" VerticalAlignment="Center"/>
                <Button Style="{StaticResource CloseButton}" HorizontalAlignment="Right" Click="OnCancel">
                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2" Data="M5,5 L15,15 M15,5 L5,15" Width="20" Height="20"/>
                </Button>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,16,20,16">
                    <Border Background="{StaticResource Card2Brush}" BorderBrush="{StaticResource HairlineBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="TELEGRAM (БИНАРНИК ДЛЯ ЗАПУСКА)" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource SubtleBrush}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TgBox" Style="{StaticResource FieldBox}"/>
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Обзор…" Margin="8,0,0,0" Click="OnBrowseTg"/>
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Авто" Margin="8,0,0,0" Click="OnAutoTg"/>
                            </Grid>
                            <TextBlock x:Name="TgStatus" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,10" Foreground="{StaticResource SubtleBrush}"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="⬇  Скачать переносной Telegram"
                                    HorizontalAlignment="Left" Click="OnDownloadTg"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Card2Brush}" BorderBrush="{StaticResource HairlineBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ПРОКСИ-ОБЁРТКА (HTTP / SOCKS5 НА КОНТЕЙНЕР)" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource SubtleBrush}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PcBox" Style="{StaticResource FieldBox}"/>
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Авто" Margin="8,0,0,0" Click="OnAutoPc"/>
                            </Grid>
                            <TextBlock x:Name="PcStatus" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,10" Foreground="{StaticResource SubtleBrush}"/>
                            <Button Style="{StaticResource GhostButton}" Content="⬇  Скачать прокси-обёртку"
                                    HorizontalAlignment="Left" Click="OnDownloadPc"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Card2Brush}" BorderBrush="{StaticResource HairlineBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="СПИСОК КОНТЕЙНЕРОВ" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource SubtleBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="Плотность" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="DensityBox" Style="{StaticResource FieldCombo}" SelectionChanged="OnDensityChanged"
                                      AutomationProperties.Name="Плотность списка" Margin="0,0,0,12">
                                <ComboBoxItem Content="Обычная: просторные карточки" Tag="comfortable"/>
                                <ComboBoxItem Content="Компактная: одна строка на контейнер" Tag="compact"/>
                            </ComboBox>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="Высота карточки" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="HeightBox" Style="{StaticResource FieldCombo}" AutomationProperties.Name="Высота карточки">
                                        <ComboBoxItem Content="Минимальная" Tag="4"/>
                                        <ComboBoxItem Content="Низкая" Tag="6"/>
                                        <ComboBoxItem Content="Средняя" Tag="10"/>
                                        <ComboBoxItem Content="Высокая" Tag="16"/>
                                        <ComboBoxItem Content="Максимальная" Tag="22"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Размер кнопок" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="SizeBox" Style="{StaticResource FieldCombo}" AutomationProperties.Name="Размер кнопок">
                                        <ComboBoxItem Content="Малые" Tag="small"/>
                                        <ComboBoxItem Content="Средние" Tag="medium"/>
                                        <ComboBoxItem Content="Крупные" Tag="large"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Вид кнопок" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="StyleBox" Style="{StaticResource FieldCombo}" AutomationProperties.Name="Вид кнопок" Margin="0,0,0,12">
                                <ComboBoxItem Content="С подписями" Tag="text"/>
                                <ComboBoxItem Content="Только значки (подсказка при наведении)" Tag="icon"/>
                            </ComboBox>
                            <TextBlock Text="Кнопки на карточке" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                            <UniformGrid Columns="2">
                                <CheckBox x:Name="LaunchChk" Style="{StaticResource GlassCheck}" Content="Запуск"/>
                                <CheckBox x:Name="StopChk" Style="{StaticResource GlassCheck}" Content="Стоп"/>
                                <CheckBox x:Name="FolderChk" Style="{StaticResource GlassCheck}" Content="Папка"/>
                                <CheckBox x:Name="ExportChk" Style="{StaticResource GlassCheck}" Content="Экспорт session"/>
                                <CheckBox x:Name="CleanupChk" Style="{StaticResource GlassCheck}" Content="Чистка"/>
                                <CheckBox x:Name="EditChk" Style="{StaticResource GlassCheck}" Content="Изменить"/>
                                <CheckBox x:Name="DeleteChk" Style="{StaticResource GlassCheck}" Content="Удалить"/>
                            </UniformGrid>
                            <TextBlock Text="Скрытые действия остаются в меню карточки (правая кнопка мыши). Смена плотности выставляет рекомендуемые высоту и кнопки."
                                       TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource SubtleBrush}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Card2Brush}" BorderBrush="{StaticResource HairlineBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="ПРОЧЕЕ" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource SubtleBrush}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ManyChk" Style="{StaticResource GlassCheck}"
                                      Content="Разрешать много окон одновременно (флаг -many)" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="DataLabel" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Открыть" Click="OnOpenData"/>
                            </Grid>
                            <Button Style="{StaticResource GhostButton}" Content="📌  Ярлык на рабочий стол"
                                    HorizontalAlignment="Left" Click="OnShortcut"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,16,20,16">
                <Button Style="{StaticResource GhostButton}" Content="Отмена" Click="OnCancel" Margin="0,0,8,0" IsCancel="True"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Сохранить" Click="OnSave" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
