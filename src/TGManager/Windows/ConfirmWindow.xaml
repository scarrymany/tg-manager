<Window x:Class="TGManager.Windows.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TG Manager"
        Width="620" SizeToContent="Height"
        MinHeight="180" MaxHeight="760"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource FgBrush}"
        FontSize="13"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="6" UseAeroCaptionButtons="False" NonClientFrameEdges="None"/>
    </WindowChrome.WindowChrome>
    <Border x:Name="WindowFrame" Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" IsHitTestVisible="False"/>
            <Border Grid.Row="2" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" IsHitTestVisible="False"/>
            <TextBlock x:Name="TitleText" Text="TG Manager" Margin="18,0,18,0"
                       FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource FgWhiteBrush}"
                       VerticalAlignment="Center"/>
            <ScrollViewer Grid.Row="1" Margin="20,16,20,16" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="BodyText" TextWrapping="Wrap" FontSize="13" LineHeight="20"/>
            </ScrollViewer>
            <WrapPanel x:Name="Buttons" Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="20,16,20,16"/>
        </Grid>
    </Border>
</Window>
