<Window x:Class="TGManager.Windows.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TG Manager"
        Width="480" SizeToContent="Height"
        MinHeight="180"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="16" UseAeroCaptionButtons="False" NonClientFrameEdges="None"/>
    </WindowChrome.WindowChrome>
    <Border x:Name="WindowFrame" Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Text="TG Manager" Margin="18,0,18,0"
                       FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource FgWhiteBrush}"
                       VerticalAlignment="Center"/>
            <StackPanel Grid.Row="1" Margin="18,8,18,8">
                <TextBlock x:Name="BodyText" TextWrapping="Wrap" FontSize="13" LineHeight="20"/>
            </StackPanel>
            <StackPanel x:Name="Buttons" Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="18,8,18,16"/>
        </Grid>
    </Border>
</Window>
